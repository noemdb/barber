TELEGRAM_BOT_TOKEN=""
# chat_id (grupo o chat directo) que recibe las notificaciones; número negativo si es grupo
TELEGRAM_CHAT_ID=""
# Token base64 generado en UploadThing (incluye apiKey, appId y regions)
UPLOADTHING_TOKEN="replace-with-your-uploadthing-token"

