generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  barber       Barber?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Barber {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  specialty    String?
  active       Boolean       @default(true)
  avatar       String?
  userId       String?       @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  services     BarberService[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  notes        String?
  avatar       String?
  active       Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([phone])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  durationMin  Int           @default(30)
  priceCents   Int
  active       Boolean       @default(true)
  appointments Appointment[]
  barbers      BarberService[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
  @@map("barber_services")
}

model Appointment {
  id            String            @id @default(cuid())
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus  @default(PENDING)
  notes         String?
  priceCents    Int
  clientId      String
  barberId      String
  serviceId     String
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber        Barber            @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payment       Payment?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([barberId, startsAt])
  @@index([serviceId])
  @@index([clientId, startsAt])
}

/// Retiene temporalmente un horario mientras el cliente completa la reserva (anti doble-reserva).
model SlotHold {
  id        String   @id @default(cuid())
  barberId  String
  startsAt  DateTime
  endsAt    DateTime
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([barberId, startsAt])
  @@index([token])
  @@index([expiresAt])
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  amountCents   Int
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  paidAt       DateTime?
  notes         String?
  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, paidAt])
}

model BusinessSettings {
  id              String   @id @default(cuid())
  businessName    String   @default("Barber Shop Central")
  subname         String?
  subtitle        String?
  slogan          String?
  tagline         String?
  logoUrl         String?
  faviconUrl      String?
  heroImageUrl    String?
  heroBackgroundUrl String?
  description     String?
  phone           String?
  email           String?
  whatsapp        String?
  address         String?
  mapsUrl         String?
  instagramUrl    String?
  facebookUrl     String?
  currency        String   @default("USD")
  timezone        String   @default("America/Caracas")
  appointmentSlot Int      @default(30)
  telegramChatId  String?
  paletteSlug     String?
  hours           BusinessHour[]
  testimonials    Testimonial[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ColorPalette {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  accent      String
  accentLight String
  accentDark  String
  isDefault   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@map("color_palettes")
}

model BusinessHour {
  id        String          @id @default(cuid())
  businessId String
  dayOfWeek Int
  openTime  String?
  closeTime String?
  business  BusinessSettings @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Testimonial {
  id         String         @id @default(cuid())
  businessId String
  author     String
  role       String?
  quote      String
  rating     Int            @default(5)
  order      Int            @default(0)
  business   BusinessSettings @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([businessId, order])
}

enum BinnacleCategory {
  AUTHENTICATION
  USER_ACTION
  SYSTEM
  SECURITY
  ERROR
}

enum BinnacleSeverity {
  DEBUG
  INFO
  WARNING
  CRITICAL
  ALERT
}

model BinnacleEntry {
  id                String            @id @default(cuid())
  eventType         String            @map("event_type")
  category          BinnacleCategory  @default(SYSTEM) @map("event_category")
  severity          BinnacleSeverity  @default(INFO) @map("event_severity")
  title             String
  description       String?           @db.Text

  subjectType       String?           @map("subject_type")
  subjectId         String?           @map("subject_id")
  subjectIdentifier String?           @map("subject_identifier")

  objectType        String?           @map("object_type")
  objectId          String?           @map("object_id")
  objectIdentifier  String?           @map("object_identifier")

  ipAddress         String?           @map("ip_address") @db.VarChar(45)
  userAgent         String?           @map("user_agent") @db.Text
  requestMethod     String?           @map("request_method") @db.VarChar(10)
  requestUrl        String?           @map("request_url") @db.Text
  sessionId         String?           @map("session_id") @db.VarChar(200)

  oldValues         Json?             @map("old_values")
  newValues         Json?             @map("new_values")
  changedFields     String[]          @default([]) @map("changed_fields")
  metadata          Json?

  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([eventType])
  @@index([category])
  @@index([severity])
  @@index([subjectType, subjectId, createdAt])
  @@index([objectType, objectId, createdAt])
  @@index([createdAt])
  @@index([ipAddress])
  @@map("binnacle_entries")
}

model VisitorSession {
  id          String   @id @default(cuid())
  fingerprint String   @unique @db.VarChar(64)
  country     String?  @map("country")
  city        String?  @map("city")
  device      String?  @map("device") // "mobile" | "tablet" | "desktop"
  browser     String?  @map("browser")
  os          String?  @map("os")
  referrer    String?  @map("referrer") @db.Text
  isOrganic   Boolean  @default(false) @map("is_organic")
  pagesViewed Int      @default(1) @map("pages_viewed")
  duration    Int      @default(0) @map("duration") // segundos totales
  bounced     Boolean  @default(true) @map("bounced")
  firstSeen   DateTime @default(now()) @map("first_seen")
  lastSeen    DateTime @default(now()) @map("last_seen")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([firstSeen])
  @@index([lastSeen])
  @@index([country])
  @@index([isOrganic])
  @@map("visitor_sessions")
}

model PageView {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  path      String   @map("path")
  referrer  String?  @map("referrer") @db.Text
  isOrganic Boolean  @default(false) @map("is_organic")
  duration  Int      @default(0) @map("duration") // segundos en la página
  createdAt DateTime @default(now()) @map("created_at")

  @@index([path])
  @@index([sessionId])
  @@index([createdAt])
  @@map("page_views")
}
